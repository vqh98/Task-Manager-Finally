BOT_TOKEN=123456:telegram-bot-token
# برای بله: https://tapi.bale.ai (در فایل جداگانه .env.bale)
BOT_API_BASE_URL=
ENABLE_GOOGLE_CALENDAR=1
PLATFORM_LABEL=تلگرام
PLATFORM_KEY=telegram
# فقط این شناسه تلگرام اجازه استفاده از ربات را دارد. برای چند کاربر با کاما جدا کنید.
ALLOWED_USER_IDS=123456789
TIMEZONE=Asia/Tehran
DAILY_DIGEST_HOUR=22
DAILY_DIGEST_MINUTE=0
MORNING_SCHEDULE_HOUR=9
MORNING_SCHEDULE_MINUTE=0
DEADLINE_WARNING_DAYS=2
REPORT_WARNING_HOURS=48
DATABASE_PATH=task_manager.db
LOG_PATH=logs/taskmanager.log
LOG_LEVEL=INFO
LOG_TO_CONSOLE=1
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# هوش مصنوعی (اختیاری — برای خلاصه‌سازی پیام، تحلیل ویس و درک بهتر متن)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# اتصال اختیاری Google Calendar. Redirect URI باید HTTPS و در Google Cloud ثبت شده باشد.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/google/oauth/callback
# وب‌سرور callback فقط روی localhost گوش می‌دهد و باید پشت reverse proxy باشد.
GOOGLE_OAUTH_HOST=127.0.0.1
GOOGLE_OAUTH_PORT=8080
# یک کلید Fernet ثابت بسازید: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# جایگزین حالت Web: فایل OAuth Desktop/Installed و اتصال دستی با ارسال URL نهایی
GOOGLE_OAUTH_CLIENT_FILE=
